# AWAPT-AI — copy to .env and configure for your environment
# NEVER commit .env to version control

# Required in production
SECRET_KEY=

# Database (Docker Compose uses Postgres)
DATABASE_URL=postgresql+asyncpg://awap:awappassword@postgres:5432/awap

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Optional: LLM for enriched descriptions (rule-based analysis works without this)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# CI/CD webhooks — comma-separated keys (no demo keys)
WEBHOOK_API_KEYS=

# Scan tuning (architecture §11.2)
SCAN_MAX_PAGES=50
SCAN_RATE_LIMIT=10
MAX_CONCURRENT_CONNECTIONS=20

# Out-of-band callback server (for blind SSRF etc.)
OAST_SERVER=

# Optional OSINT
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
